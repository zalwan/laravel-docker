APP_NAME=BAWANA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-project.vercel.app

LOG_CHANNEL=stderr
CACHE_STORE=array
SESSION_DRIVER=cookie
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Demo mode uses a seeded SQLite template copied to /tmp by api/index.php.
# Data can reset on cold starts and is not a production persistence strategy.
DB_CONNECTION=sqlite
DB_DATABASE=/tmp/database.sqlite
DB_FOREIGN_KEYS=true

# Production option: replace the SQLite settings above with a managed database.
# DB_CONNECTION=mysql
# DB_HOST=
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=
# DB_URL=
